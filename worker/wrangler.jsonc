{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energym-gate",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "eg.lambder.com",
      "custom_domain": true
    }
  ]
}
