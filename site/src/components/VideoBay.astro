---
type Props = {
  label?: string;
  sub?: string;
};
const { label = "The promo drops here", sub = "16:9 · sound on · loop ready" } = Astro.props;
---

<div class="video-bay" data-video-bay aria-label="Reserved space for the Energym promo video">
  <div class="video-bay__bg"></div>
  <div class="video-bay__scan"></div>
  <span class="video-bay__corner video-bay__corner--tl">Energym / trailer bay</span>
  <span class="video-bay__corner video-bay__corner--br">1920 × 1080 · 16:9</span>
  <div class="video-bay__content">
    <div class="video-bay__play" aria-hidden="true"></div>
    <p class="video-bay__label">{label}</p>
    <p class="video-bay__sub">{sub}</p>
    <span class="sticker sticker--pink" style="margin-top:18px;">Coming soon</span>
  </div>
</div>
