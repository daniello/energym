---
type Props = {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: string;
  stamp?: string;
  tilt?: string;
};

const { eyebrow, title, lede, image, stamp, tilt = "-1deg" } = Astro.props;
---

<section class="section section--ink" style="position:relative;overflow:hidden;">
  <div class="wrap" style="position:relative;z-index:2;">
    <div class="split split--middle">
      <div data-reveal>
        {eyebrow && <p class="eyebrow" style="color:var(--acid);margin-bottom:14px;">{eyebrow}</p>}
        <h1 style="font-size:clamp(3rem,8vw,6.5rem);" set:html={title} />
        {lede && <p class="mt-2" style="max-width:50ch;color:rgba(243,234,215,.78);font-size:1.08rem;">{lede}</p>}
        {stamp && <span class="sticker sticker--pink mt-2">{stamp}</span>}
      </div>
      {
        image && (
          <div class="panel" data-reveal style={`transform:rotate(${tilt});`}>
            <div class="comic-photo" style="aspect-ratio:4/3;">
              <img src={image} alt="" loading="eager" />
              <span class="halftone"></span>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
